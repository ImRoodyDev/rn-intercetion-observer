{
  "name": "@imroodydev/rn-intersection-observer",
  "version": "1.0.0-alpha.0",
  "description": "react native intersection observer",
  "keywords": [
    "react",
    "react-native",
    "intersection",
    "intersection-observer",
    "IntersectionObserver"
  ],
  "author": "ImRoodyDev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImRoodyDev/rn-intersection-observer.git"
  },
