    "npm:publish:alpha": "npm publish --tag alpha",
    "npm:publish:dry-run": "npm publish --dry-run --tag alpha",
    "dotenv:npm:publish": "npx -p dotenv-cli dotenv -e .env -- npm publish --tag",
    "dotenv:npm:publish:alpha": "npx -p dotenv-cli dotenv -e .env -- npm publish --tag alpha",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "lodash": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "@types/jest": "^26.0.23",
    "@types/react-native": "^0.67.3",
    "@types/react-test-renderer": "^17.0.1",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "babel-jest": "^26.6.3",
    "eslint": "^7.32.0",
    "jest": "^26.6.3",
    "metro-react-native-babel-preset": "^0.67.0",
    "react": "17.0.2",
    "react-native": "0.68.2",
    "react-test-renderer": "17.0.2",
    "typescript": "^4.9.5"
  },
  "resolutions": {
    "@types/react": "^17"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
